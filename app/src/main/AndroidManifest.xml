<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="类原生运营商信息优化"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- LSPosed / Xposed 模块声明 -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="类原生运营商信息优化：运营商名改中文、LTE 显示 4G、锁屏双卡细竖线" />
        <!-- 推荐作用域（旧版管理器读这个数组，新版读 assets/xposed_scope） -->
        <meta-data android:name="xposedscope" android:resource="@array/xposedscope" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <!-- 让模块自己的 SharedPreferences 可被注入进程读取 -->
        <meta-data android:name="xposedsharedprefs" android:value="true" />

        <!-- 没有 Activity：模块不提供任何界面，开关直接嵌在「设置 - 系统 - 状态栏」页 -->

    </application>

</manifest>
